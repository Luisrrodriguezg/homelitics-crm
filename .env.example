# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored and dockerignored — never commit it.
#
# The two URLs are DIFFERENT POOLERS and are not interchangeable. This is the
# single most common way to break this project.
# ---------------------------------------------------------------------------

# API runtime. Supabase → Settings → Database → Connection string → Transaction pooler.
# Port 6543. Driver must be postgresql+asyncpg.
DATABASE_URL=postgresql+asyncpg://postgres.msmpbounvqtfobcfyffr:PASSWORD@aws-0-us-west-2.pooler.supabase.com:6543/postgres

# Migrations, seeding, verify_db.py. Same page → Session pooler. Port 5432.
# Plain psycopg2 URI (no +asyncpg): these tools are synchronous and use COPY.
DATABASE_URL_MIGRATE=postgresql://postgres.msmpbounvqtfobcfyffr:PASSWORD@aws-0-us-west-2.pooler.supabase.com:5432/postgres

# --- Supabase Auth -------------------------------------------------------
SUPABASE_PROJECT_REF=msmpbounvqtfobcfyffr

# Leave BLANK on modern projects: they sign with asymmetric keys and the API
# fetches the public JWKS, so no secret is needed. Only set this if the project
# is still on legacy HS256 (Settings → API → JWT Keys shows a shared secret).
SUPABASE_JWT_SECRET=

SUPABASE_JWT_AUDIENCE=authenticated

# Only scripts/provision_agent_users.py reads these two. The service-role key
# bypasses RLS and creates users — keep it OUT of any frontend and never commit it.
# Supabase → Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=
# One shared password for every demo agent login the script creates (≥ 8 chars).
DEMO_AGENT_PASSWORD=

# --- Background jobs -----------------------------------------------------
# On Supabase the inactivity sweep and the outbox relay run INSIDE Postgres via
# pg_cron (migrations/005_cron_jobs.sql). Leave the in-process scheduler OFF
# there, or every follow-up is raised twice. Set it to true only on the local
# compose profile (no pg_cron) or on a plain Postgres without cron.
ENABLE_SCHEDULER=false
INACTIVITY_HOURS=72            # must match the 72 in the pg_cron job (005)
SCHEDULER_INTERVAL_MINUTES=60
EVENT_RELAY_SECONDS=30

# --- App -----------------------------------------------------------------
APP_TIMEZONE=America/Bogota    # agents publish availability in local time
ENFORCE_AVAILABILITY=false     # true => a visit outside published slots is 409
LOG_LEVEL=INFO
# The frontend origin(s), comma-separated. `*` is fine for curl/Swagger but a
# browser will refuse credentialed requests against a wildcard.
CORS_ORIGINS=*
